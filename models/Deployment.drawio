        <mxCell id="optimizationModule" value="&lt;&lt;component&gt;&gt;&lt;br&gt;Optimization Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="appNode"><mxGeometry x="25" y="320" width="340" height="55" as="geometry"/></mxCell>
        <mxCell id="trackingModule" value="&lt;&lt;component&gt;&gt;&lt;br&gt;Tracking &amp;amp; Notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="appNode"><mxGeometry x="25" y="390" width="340" height="55" as="geometry"/></mxCell>
        <mxCell id="adapterNote" value="In-process module interfaces / domain events&lt;br&gt;Ports and infrastructure adapters at boundaries" style="text;html=1;align=center;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="appNode"><mxGeometry x="25" y="455" width="340" height="35" as="geometry"/></mxCell>
        <mxCell id="primaryNode" value="&lt;&lt;database&gt;&gt;&lt;br&gt;&lt;b&gt;Primary Relational Database&lt;/b&gt;" style="swimlane;html=1;startSize=42;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="primaryArtifact" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Operational schema&lt;br&gt;Orders • Batches • Drivers&lt;br&gt;Vehicles • Routes • Stops" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="primaryNode"><mxGeometry x="40" y="65" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="replicaNode" value="&lt;&lt;database&gt;&gt;&lt;br&gt;&lt;b&gt;Read Replica&lt;/b&gt;" style="swimlane;html=1;startSize=42;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="350" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="replicaArtifact" value="&lt;&lt;artifact&gt;&gt;&lt;br&gt;Replicated read-only schema&lt;br&gt;Asynchronous / potentially stale" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="replicaNode"><mxGeometry x="40" y="65" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="mappingNode" value="&lt;&lt;external system&gt;&gt;&lt;br&gt;&lt;b&gt;Mapping / Routing Provider&lt;/b&gt;&lt;br&gt;Geocoding • Distance matrix • Route estimates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="650" y="730" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="messagingNode" value="&lt;&lt;external system&gt;&gt;&lt;br&gt;&lt;b&gt;Messaging Provider&lt;/b&gt;&lt;br&gt;Push / SMS notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="730" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="c1" value="HTTPS" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="dispatcherNode" target="edgeNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2" value="HTTPS" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="driverNode" target="edgeNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3" value="Protected HTTP / REST" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="edgeNode" target="appNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c4" value="SQL over TLS — read / write" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="appNode" target="primaryNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c5" value="Asynchronous replication" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;" edge="1" parent="1" source="primaryNode" target="replicaNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c6" value="Read-only stale-tolerant queries" style="endArrow=block;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="appNode" target="replicaNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c7" value="HTTPS via RoutingEnginePort" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="appNode" target="mappingNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c8" value="HTTPS via NotificationPort" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="appNode" target="messagingNode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="integrityNote" value="Deployment constraints&lt;br&gt;• One deployable application; modules are not separate services&lt;br&gt;• Gateway handles edge concerns only; no domain rules or persistence&lt;br&gt;• Primary is the sole write authority; consistency-sensitive reads use primary&lt;br&gt;• Replica is read-only and may lag; automatic failover is not implied&lt;br&gt;• No message broker is deployed in this phase" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="870" width="1000" height="100" as="geometry"/></mxCell>
      </root>
